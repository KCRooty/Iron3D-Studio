// Recursos de Windows de Iron3DStudio.exe. Se genera con configure_file() desde CMakeLists.txt:
// la version sale de IRON3D_VERSION_* (un unico sitio) y llega al icono, a las Propiedades > Detalles
// (descripcion, version, producto, copyright, idioma) y al instalador.
#pragma code_page(65001)
#include <winver.h>

// Icono del ejecutable (Explorador, barra de tareas, Alt+Tab). GLFW usa "GLFW_ICON" para su ventana.
GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/assets/icon.ico"
1 ICON "@CMAKE_SOURCE_DIR@/assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @IRON3D_VERSION_MAJOR@,@IRON3D_VERSION_MINOR@,@IRON3D_VERSION_PATCH@,0
 PRODUCTVERSION @IRON3D_VERSION_MAJOR@,@IRON3D_VERSION_MINOR@,@IRON3D_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Espanol (Espana)
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Static Forge"
            VALUE "FileDescription", "Iron3D Studio - modelado, animación y render 3D"
            VALUE "FileVersion", "@IRON3D_VERSION_STRING@"
            VALUE "InternalName", "Iron3DStudio"
            VALUE "LegalCopyright", "Copyright © 2026 Static Forge. Licencia MIT o Apache-2.0."
            VALUE "OriginalFilename", "Iron3DStudio.exe"
            VALUE "ProductName", "Iron3D Studio"
            VALUE "ProductVersion", "@IRON3D_VERSION_STRING@"
            VALUE "Comments", "Versión alpha: software en desarrollo temprano."
        END
        // Ingles (Estados Unidos)
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Static Forge"
            VALUE "FileDescription", "Iron3D Studio - 3D modeling, animation and rendering"
            VALUE "FileVersion", "@IRON3D_VERSION_STRING@"
            VALUE "InternalName", "Iron3DStudio"
            VALUE "LegalCopyright", "Copyright © 2026 Static Forge. MIT or Apache-2.0 license."
            VALUE "OriginalFilename", "Iron3DStudio.exe"
            VALUE "ProductName", "Iron3D Studio"
            VALUE "ProductVersion", "@IRON3D_VERSION_STRING@"
            VALUE "Comments", "Alpha release: early-development software."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200, 0x0409, 1200
    END
END
